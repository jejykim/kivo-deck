{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kivo Deck",
  "version": "0.3.2",
  "identifier": "lab.kivo.deck",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Kivo Deck",
        "width": 1280,
        "height": 820,
        "label": "main",
        "minWidth": 1080,
        "minHeight": 700,
        "visible": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "dmg",
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "publisher": "Kivo Lab",
    "shortDescription": "Kivo Deck 설정 앱"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk4NDNCQkI3RTYzNERBM0IKUldRNzJqVG10N3REbUtyT0trOWJRWWwrK1phbCtzNW5NdXFBSU5mK0xiTjN3RnNWU2t2MVo2MWcK",
      "endpoints": [
        "https://github.com/jejykim/kivo-deck/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}